# ─────────────────────────────────────────────────────────────────────────────
# SpotDown — Spotify API Credentials
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env
#       cp .env.example .env
#
# 2. Fill in your Spotify Developer credentials:
#    https://developer.spotify.com/dashboard → create app → Settings
#
# 3. In your Spotify App settings, add this Redirect URI:
#       http://<your-lan-ip>:5000/callback
#    e.g. http://10.216.130.27:5000/callback
#
# ─────────────────────────────────────────────────────────────────────────────

# NOTE: Spotify Web API now requires a Spotify Premium account for developer apps.
# If you DO NOT have Spotify Premium, leave these blank or commented out.
# SpotDown will automatically run in free scraping mode without credentials.
#
# SPOTIFY_CLIENT_ID=your_client_id_here
# SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Local host and port configuration
HOST=127.0.0.1
PORT=5000
